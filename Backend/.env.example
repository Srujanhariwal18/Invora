# ==============================================================================
# Invora — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Supabase PostgreSQL connection URL
# Format: jdbc:postgresql://<HOST>:<PORT>/postgres
# Use the "Transaction" pooler URL from your Supabase project dashboard (port 6543)
# or the direct connection URL (port 5432).
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres

# Supabase database user (usually "postgres" for direct, or "postgres.<project-ref>" for pooler)
DB_USER=<SUPABASE_USER>

# Supabase database password (from Project Settings → Database → Password)
DB_PASSWORD=<SUPABASE_PASSWORD>

# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# JWT Configuration (Secret must be at least 256 bits / 32 bytes)
JWT_SECRET=<YOUR_STRONG_JWT_SECRET_KEY>
JWT_EXPIRATION_MS=86400000
