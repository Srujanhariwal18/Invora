# ==============================================================================
# Invora — Environment Variables Configuration
# Copy this file to .env (in Backend/ or project root) and fill in your Supabase credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ── SUPABASE POSTGRESQL DATASOURCE ───────────────────────────────────────────
# How to get your connection details from Supabase:
# 1. Open your Supabase Project Dashboard: https://supabase.com/dashboard
# 2. Go to Project Settings -> Database
# 3. Under "Connection string", select "URI" or "JDBC":
#
# Option A: Session Pooler (RECOMMENDED for Spring Boot with poolers):
#   Host: aws-0-<region>.pooler.supabase.com (Port: 5432)
#   Username: postgres.<your-project-ref>
#   URL: jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
#
# Option B: Direct Connection (Port: 5432):
#   Host: db.<your-project-ref>.supabase.co (Port: 5432)
#   Username: postgres
#   URL: jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
DB_USER=postgres.<PROJECT_REF>
DB_PASSWORD=<YOUR_SUPABASE_DATABASE_PASSWORD>

# ── SPRING PROFILES ───────────────────────────────────────────────────────────
# Active profile: dev (verbose logging, auto-reload) | prod (hardened security)
SPRING_PROFILES_ACTIVE=dev

# ── FLYWAY MIGRATION LOCATIONS (OPTIONAL) ──────────────────────────────────────
# In 'dev', defaults to: classpath:db/migration,classpath:db/seed (seeds demo users & inventory)
# In 'prod', strictly locked to: classpath:db/migration (clean production schema only)
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# ── JWT CONFIGURATION ─────────────────────────────────────────────────────────
# Required for production (must be at least 256 bits / 32 characters long).
# In 'dev' profile, defaults to an internal development key if not specified.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
